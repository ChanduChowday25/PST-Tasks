import java.util.*;

class Result {
    public static int birthday(List<Integer> s, int d, int m) {
        int count = 0;
        int currentSum = 0;

        // Initial window sum
        for (int i = 0; i < m && i < s.size(); i++) {
            currentSum += s.get(i);
        }
        if (currentSum == d) count++;

        // Sliding window
        for (int i = m; i < s.size(); i++) {
            currentSum = currentSum - s.get(i - m) + s.get(i);
            if (currentSum == d) count++;
        }
        return count;
    }
}
